;;; The same operations in plain Coil: raw slices and pointers, no checks.
(module bench.raw-ops)
(import "coil.time" :as time)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.cc" :as cc)
(import "coil.scratch" :use [ScratchArena])

;;; A list node: a number and the next node, or null at the end.
(defstruct Node [(n i64) (next (ptr Node))])

(defn null-node [] (-> (ptr Node)) (primitive/cast (ptr Node) 0))

(defn heap-list [(k i64)] (-> (ptr Node))
  (if (= k 0)
      (null-node)
      (let [p (primitive/cast (ptr Node) (alloc/malloc (primitive/cast isize (primitive/sizeof Node))))]
        (store! p (Node :n k :next (heap-list (- k 1))))
        p)))

(defn arena-list [(ar (ptr ScratchArena)) (k i64)] (-> (ptr Node))
  (if (= k 0)
      (null-node)
      (let [p (match (alloc/allocate ar (some-request))
                (Some [m] (primitive/cast (ptr Node) m))
                (None [] (panic "out of memory")))]
        (store! p (Node :n k :next (arena-list ar (- k 1))))
        p)))

(defn some-request [] (-> alloc/AllocRequest)
  (match (alloc/request [Node] 1) (Some [r] r) (None [] (panic "bad request"))))

(defn total [(p (ptr Node))] (-> i64)
  (if (= (primitive/cast i64 p) 0) 0 (+ (load (field p n)) (total (load (field p next))))))

(defn free-list [(p (ptr Node))] (-> void)
  (unless (= (primitive/cast i64 p) 0)
    (free-list (load (field p next)))
    (primitive/free (primitive/cast (ptr i8) p)))
  0)

(defn now [] (-> i64) (match (time/monotonic-now-ms) (Ok [ms] ms) (Err [_] 0)))

(defn report [(name (slice u8)) (start i64) (result i64)] (-> void)
  (println "{:>10} {:>6} ms  ({})" name (- (now) start) result))

(defn add [(acc i64) (x (ptr i64))] (-> i64) (+ acc (load x)))

(defn fold [(xs (slice i64)) (start i64) (f (fnptr (cc/C) [i64 (ptr i64)] i64))] (-> i64)
  (let [(mut acc) start]
    (for i (range 0 (len xs)) (set! acc (f acc (primitive/index (data xs) i))))
    acc))

;;; The same, kept out of line: a call through the pointer it is given.
(defn fold-erased :inline (Never) [(xs (slice i64)) (start i64) (f (fnptr (cc/C) [i64 (ptr i64)] i64))] (-> i64)
  (let [(mut acc) start]
    (for i (range 0 (len xs)) (set! acc (f acc (primitive/index (data xs) i))))
    acc))

(defn main [] (-> i64)
  (let [n 1000000
        reps 200
        a (alloc/malloc-allocator)
        v (some-or-panic (alloc/alloc [i64] a n))
        boxes (some-or-panic (alloc/alloc [(ptr i64)] a n))
        (mut seed) (now)]
    (for i (range 0 n)
      (set! seed (% (+ (* seed 1103515245) 12345) 2147483648))
      (store! (primitive/index (data v) i) (% seed 100))
      (store! (primitive/index (data boxes) i) (alloc/box! a i64 (% seed 100))))
    (let [start (now) (mut sum) 0]
      (for r (range 0 reps) (for i (range 0 n) (set! sum (+ sum (load (primitive/index (data v) i))))))
      (report "get" start sum))
    (let [start (now) (mut sum) 0]
      (for r (range 0 reps) (for x v (set! sum (+ sum x))))
      (report "for" start sum))
    (let [start (now) (mut sum) 0]
      (for r (range 0 reps) (for i (range 0 n) (set! sum (add sum (primitive/index (data v) i)))))
      (report "closure" start sum))
    (let [start (now) (mut sum) 0]
      (for r (range 0 reps) (set! sum (fold v sum (fnptr-of add))))
      (report "fold" start sum))
    (let [start (now) (mut sum) 0]
      (for r (range 0 reps) (set! sum (fold-erased v sum (fnptr-of add))))
      (report "fold erased" start sum))
    (let [start (now) (mut sum) 0]
      (for r (range 0 reps) (for i (range 0 n) (set! sum (+ sum (load (primitive/index (data v) i))))))
      (report "pool" start sum))
    (let [start (now) (mut sum) 0]
      (for r (range 0 reps) (for i (range 0 n) (set! sum (+ sum (load (load (primitive/index (data boxes) i)))))))
      (report "box" start sum))
    (let [start (now) (mut sum) 0]
      (for r (range 0 1000)
        (let [l (heap-list 10000)] (set! sum (+ sum (total l))) (free-list l)))
      (report "heap list" start sum))
    (let [start (now) (mut sum) 0
          (mut sa) (primitive/zeroed ScratchArena)
          ar (ScratchArena::init-with-capacity (mut sa) (alloc/malloc-allocator) 4096)]
      (for r (range 0 1000)
        (let [l (arena-list ar 10000)] (set! sum (+ sum (total l))))
        (ScratchArena::reset! ar))
      (ScratchArena::close! ar)
      (report "arena list" start sum)))
  0)

(defn some-or-panic [T] [(o (Option (slice T)))] (-> (slice T))
  (match o (Some [s] s) (None [] (panic "out of memory"))))
