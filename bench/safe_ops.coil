;;; The safe library's common operations, timed: compiled with --use safe.check.
(module bench.safe-ops)
(import "coil.time" :as time)
(import "coil.primitive" :as primitive)
(import "safe.vec" :use [Vec])
(import "safe.box" :use [Box BoxIn])
(import "safe.alloc" :use [Arena ArenaRef])
(import "safe.core" :use [View])
(import "safe.pool" :use [Pool Handle])
(import "safe.fn" :use [deffn lambda])
(import "safe.loop" :use [for])

(deffn Step [i64 (ref i64)] i64)

;;; A higher-order function the closure is given to.
(defn fold [(xs (ref (Vec i64))) (start i64) (f (mut Step))] (-> i64)
  (let [(mut acc) start]
    (for i (range 0 (len xs)) (set! acc (Step::run (mut f) acc (Vec::at xs i))))
    acc))

;;; A list of numbers on the heap, a box a node.
(defsum HeapList (HeapEnd) (HeapLink [(n i64) (next (Box HeapList))]))

(defn heap-list [(k i64)] (-> HeapList)
  (if (= k 0) (HeapEnd) (HeapLink :n k :next (Box::new (heap-list (- k 1))))))

(defn heap-total [(l (ref HeapList))] (-> i64)
  (match l (HeapEnd [] 0) (HeapLink [n next] (+ n (heap-total (Box::get next))))))

;;; The same list in an arena: a view, which keeps the arena lent.
(defsum ArenaList (ArenaEnd) (ArenaLink [(n i64) (next (BoxIn ArenaList ArenaRef))]))

(impl View ArenaList)

(defn arena-list [(ar (ref Arena)) (k i64)] (-> ArenaList)
  (if (= k 0) (ArenaEnd) (ArenaLink :n k :next (BoxIn::in-arena [ArenaList] ar (arena-list ar (- k 1))))))

(defn arena-total [(l (ref ArenaList))] (-> i64)
  (match l (ArenaEnd [] 0) (ArenaLink [n next] (+ n (arena-total (BoxIn::get next))))))

(defn now [] (-> i64) (match (time/monotonic-now-ms) (Ok [ms] ms) (Err [_] 0)))

(defn report [(name (slice u8)) (start i64) (result i64)] (-> void)
  (println "{:>10} {:>6} ms  ({})" name (- (now) start) result))

(defn main [] (-> i64)
  (let [n 1000000
        reps 200
        (mut v) (Vec::new [i64])
        (mut boxes) (Vec::new [(Box i64)])
        (mut pool) (Pool::new [i64])
        (mut handles) (Vec::new [(Handle i64)])
        (mut seed) (now)]
    (for i (range 0 n)
      (set! seed (% (+ (* seed 1103515245) 12345) 2147483648))
      (Vec::push! (mut v) (% seed 100))
      (Vec::push! (mut boxes) (Box::new (% seed 100)))
      (Vec::push! (mut handles) (Pool::insert! (mut pool) (% seed 100))))
    (let [start (now) (mut sum) 0]
      (for r (range 0 reps) (for i (range 0 n) (set! sum (+ sum (get v i)))))
      (report "get" start sum))
    (let [start (now) (mut sum) 0]
      (for r (range 0 reps) (for (ref x) v (set! sum (+ sum (primitive/load x)))))
      (report "for" start sum))
    (let [start (now) (mut sum) 0
          (mut add) (lambda Step [] [acc x] (+ acc (primitive/load x)))]
      (for r (range 0 reps) (for i (range 0 n) (set! sum (Step::run (mut add) sum (Vec::at v i)))))
      (report "closure" start sum))
    (let [start (now) (mut sum) 0
          (mut add) (lambda Step [] [acc x] (+ acc (primitive/load x)))]
      (for r (range 0 reps) (set! sum (fold v sum (mut add))))
      (report "fold" start sum))
    (let [start (now) (mut sum) 0]
      (for r (range 0 reps) (for i (range 0 n) (set! sum (+ sum (primitive/load (Pool::at pool (get handles i)))))))
      (report "pool" start sum))
    (let [start (now) (mut sum) 0]
      (for r (range 0 reps) (for i (range 0 n) (set! sum (+ sum (primitive/load (Box::get (Vec::at boxes i)))))))
      (report "box" start sum))
    ;; a list of ten thousand nodes made, summed and given back, a thousand times
    (let [start (now) (mut sum) 0]
      (for r (range 0 1000)
        (let [l (heap-list 10000)] (set! sum (+ sum (heap-total l)))))
      (report "heap list" start sum))
    (let [start (now) (mut sum) 0
          (mut ar) (Arena::new)]
      (for r (range 0 1000)
        (let [l (arena-list ar 10000)] (set! sum (+ sum (arena-total l))))
        (Arena::reset! (mut ar)))
      (report "arena list" start sum)))
  0)
