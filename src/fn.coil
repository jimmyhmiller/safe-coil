;;; Closures.
;;;
;;; `(deffn NAME [T…] [PARAM-TYPE…] RESULT)` declares a closure trait: what a
;;; closure from the parameter types to RESULT can do. A parameter may be a
;;; reference, `(ref T)` or `(mut T)`; RESULT is what a function may return.
;;;
;;; `(lambda TYPE [CAPTURE…] [PARAM…] BODY…)` is a closure of the trait TYPE that
;;; borrows what it captures. A capture is `(ref x)` or `(mut x)`: inside BODY,
;;; `x` is that reference. `(NAME (ref PLACE))` or `(NAME (mut PLACE))` captures
;;; any place as NAME. The closure is a view: it keeps what it captured lent,
;;; shared or exclusively, for as long as it lives, so it is a local, an argument
;;; or a result and is never stored. It is moved, never copied.
;;;
;;; `(lambda-own TYPE [CAPTURE…] [PARAM…] BODY…)` is a closure that owns what it
;;; captures: each capture is a name, moved (or copied, for plain data) into the
;;; closure, and inside BODY it is an exclusive reference to the closure's own
;;; copy, which stays from one call to the next. It holds no reference, so it can
;;; be stored, returned, and sent to another thread.
;;;
;;; Each lambda is a type of its own, which implements TYPE: a struct of what it
;;; captured, whose `run` is BODY. So a function generic over the closure it is
;;; given, `[(F Step)] [(f (mut F))]`, calls `(Step::run (mut f) ARG…)` directly,
;;; and the call is inlined as a call of a named function is. A lambda's type has
;;; no name the program can write. Where one is kept or chosen among, it is
;;; erased: `(Step-view-of (mut f))` is a `Step-view` that borrows `f`, and
;;; `(Step-own-of f)` a `Step-own` that owns an owning closure on the heap. Both
;;; implement `Step`. `(Step::call-once f ARG…)` calls a closure and drops it;
;;; `(spawn (Step-call-once f))` runs an owning one on a thread.
;;;
;;; The `lambda` macro leaves a marker, and the transform `closures` makes the
;;; lambda's type once the compiler knows the types of what it captures.
(module safe.fn)
(export deffn lambda lambda-own place-of place-of-mut at at-mut Cap CapMut)
(import "coil.primitive" :as primitive)
(import "coil.phase" :as phase)
(import "coil.meta" :as meta)
(import "coil.str" :use *)
(import "coil.cc" :as cc)
(import "safe.core" :use [unsafe lend lend-mut View QuietDrop SharedView Droppable])
(import "safe.mem" :as mem)

;;; The address of what R refers to, as a raw pointer: a capture's place.
(defn place-of :inline (Always) [T] [(r (ref T))] (-> (ptr T))
  (unsafe (primitive/cast (ptr T) r)))

(defn place-of-mut :inline (Always) [T] [(r (mut T))] (-> (ptr T))
  (unsafe (primitive/cast (ptr T) (mut r))))

;;; What P points at, lent: a capture inside a closure's body. Only `unsafe` code
;;; can call these, as with any reference made from a raw pointer.
(defn at :inline (Always) [T] [(p (ptr T))] (-> (ref T))
  (unsafe (lend (primitive/cast (ptr T) p))))

(defn at-mut :inline (Always) [T] [(p (ptr T))] (-> (mut T))
  (unsafe (lend-mut (primitive/cast (ptr T) p))))

;;; What a closure that owns its captures holds: VALUE, moved in. Its type is
;;; the value's, so the compiler says what the closure holds.
(defn owned :inline (Always) [T] [(value T)] (-> T) value)

;;; What a closure borrowed shared: a view of it, lent from where it lies, so a
;;; closure made of these is a view made of views and keeps them lent.
(defstruct Cap [T] [(at (ptr T))])

(impl [T] View (Cap T))

(impl [T] SharedView (Cap T))

(defn cap :inline (Always) [T] [(r (ref T))] (-> (Cap T))
  (unsafe (Cap :at (primitive/cast (ptr T) r))))

(impl [T] (Cap T)
  ;;; What was captured, lent for as long as the capture is.
  (get :inline (Always) [(c (ref (Cap T)))] (-> (ref T))
    (unsafe (lend (load (field c at))))))

;;; What a closure borrowed exclusively. It is moved, never copied.
(defstruct CapMut [T] [(at (ptr T))])

(impl [T] View (CapMut T))

(impl [T] QuietDrop (CapMut T))

(impl [T] Drop (CapMut T) (drop [(self (mut (CapMut T)))] (-> void) 0))

(defn cap-mut :inline (Always) [T] [(r (mut T))] (-> (CapMut T))
  (unsafe (CapMut :at (primitive/cast (ptr T) (mut r)))))

(impl [T] (CapMut T)
  ;;; What was captured, lent to be changed for as long as the capture is.
  (get-mut :inline (Always) [(c (mut (CapMut T)))] (-> (mut T))
    (unsafe (lend-mut (load (field c at))))))

;;; ---- the closure trait and its erased forms -------------------------------------

;;; NAME with SUFFIX added, bound where NAME is: the user's module.
(defn name+ [(name Code) (suffix (slice u8))] (-> Code)
  (primitive/datum->syntax name (primitive/code-symbol name suffix)))

;;; A type parameter list to splice in: nothing when there are none.
(defn tparams [(names Code)] (-> Code)
  (if (= (len names) 0) `() `([~@names])))

;;; `(deffn NAME [T…] [PARAM-TYPE…] RESULT)`, or `(deffn NAME [PARAM-TYPE…] RESULT)`.
(defn deffn [(name Code) (a Code) (b Code) & (rest Code)] (-> Code)
  (let [; `(deffn NAME [] [PARAM…] RESULT)` names no type parameter either
        empty-tps (and (> (len rest) 0) (= (len a) 0))
        a (if empty-tps b a)
        b (if empty-tps (get rest 0) b)
        generic (and (> (len rest) 0) (not empty-tps))
        tps (if generic a `[])
        params (if generic b a)
        result (if generic (get rest 0) b)
        view-name (name+ name "-view")
        own-name (name+ name "-own")
        view-self (if generic `(~view-name ~@tps) view-name)
        own-self (if generic `(~own-name ~@tps) own-name)
        trait-of (if generic `(~name ~@tps) name)
        (mut xparams) (primitive/code-list-new)
        (mut xargs) (primitive/code-list-new)
        tramp (name+ name "-view--tramp")
        own-tramp (name+ name "-own--tramp")
        own-free (name+ name "-own--free")
        f-type (primitive/fresh-identifier "F")]
    (unless (primitive/code-vector? params)
      (primitive/error "deffn: expected (deffn NAME [T…] [PARAM-TYPE…] RESULT)"))
    ;; as in Hylo, a closure gives back a value, never a reference into what it captured
    (when (and (primitive/code-list? result) (> (len result) 0)
               (or (primitive/code-eq (get result 0) `ref) (primitive/code-eq (get result 0) `mut)))
      (primitive/error "deffn: a closure returns a value, not a reference"))
    (for i (range 0 (len params))
      (let [x (primitive/fresh-identifier "x")
            t (get params i)]
        (push! (mut xparams) `(~x ~t))
        (push! (mut xargs) (if (and (primitive/code-list? t) (primitive/code-eq (get t 0) `mut)) `(mut ~x) x))))
    `(do
       ;; what every closure of this kind does
       (deftrait ~name [Self ~@tps]
         (run [(self (ptr Self)) ~@xparams] (-> ~result))
         (call-once [(self Self) ~@xparams] (-> ~result)))
       ;; a closure that borrows, erased: the address of the closure and the
       ;; function that runs it. A view that keeps the closure lent exclusively.
       (defstruct ~view-name ~@(tparams tps)
         [(at (ptr u8)) (tramp (fnptr (cc/C) [(ptr u8) ~@params] ~result))])
       (impl ~@(tparams tps) View ~view-self)
       (impl ~@(tparams tps) QuietDrop ~view-self)
       (impl ~@(tparams tps) Drop ~view-self (drop [(self (mut ~view-self))] (-> void) 0))
       (defn ~tramp [~@tps (~f-type ~trait-of)] [(p (ptr u8)) ~@xparams] (-> ~result)
         (unsafe (~(name+ name "::run") (primitive/cast (ptr ~f-type) p) ~@xargs)))
       ;;; The closure F, erased: this keeps F lent exclusively while it lives.
       (defn ~(name+ name "-view-of") [~@tps (~f-type ~trait-of)] [(f (mut ~f-type))] (-> ~view-self)
         (unsafe (~view-name ~@(tparams tps)
                   :at (primitive/cast (ptr u8) (mut f))
                   :tramp (primitive/fnptr-of ~tramp [~@tps ~f-type]))))
       (impl ~@(tparams tps) ~name ~view-self
         (run :inline (Always) [(self (ptr ~view-self)) ~@xparams] (-> ~result)
           (unsafe (let [t (load (field self tramp))] (t (load (field self at)) ~@xargs))))
         (call-once [(self ~view-self) ~@xparams] (-> ~result)
           (let [(mut g) self] (~(name+ name "::run") (mut g) ~@xargs))))
       ;; a closure that owns, erased: the closure on the heap, the function that
       ;; runs it and the one that drops it
       (defstruct ~own-name ~@(tparams tps)
         [(at (ptr u8)) (tramp (fnptr (cc/C) [(ptr u8) ~@params] ~result)) (free (fnptr (cc/C) [(ptr u8)] void))])
       (impl ~@(tparams tps) Drop ~own-self
         (drop [(self (mut ~own-self))] (-> void)
           (unsafe (let [free (load (field self free))] (free (load (field self at)))) 0)))
       ;; what an owning closure captured is dropped with it: never a linear value
       (defn ~own-free [~@tps (~f-type ~trait-of Droppable)] [(p (ptr u8))] (-> void)
         (unsafe
           (let [at (primitive/cast (ptr ~f-type) p)
                 gone (take! [~f-type] at)]
             (mem/release (slice::new [~f-type] at 1))
             0)))
       ;;; Call the closure F once and drop it: an ordinary function, so that a
       ;;; pointer can be taken to it, as `(spawn (NAME-call-once f))` does.
       (defn ~(name+ name "-call-once") [~@tps (~f-type ~trait-of)] [(f ~f-type) ~@xparams] (-> ~result)
         (~(name+ name "::call-once") f ~@xargs))
       ;;; The owning closure F, erased, on the heap.
       (defn ~(name+ name "-own-of") [~@tps (~f-type ~trait-of Droppable)] [(f ~f-type)] (-> ~own-self)
         (unsafe
           (let [at (data (mem/room [~f-type] 1))]
             (store! at f)
             (~own-name ~@(tparams tps)
               :at (primitive/cast (ptr u8) at)
               :tramp (primitive/fnptr-of ~tramp [~@tps ~f-type])
               :free (primitive/fnptr-of ~own-free [~@tps ~f-type])))))
       (impl ~@(tparams tps) ~name ~own-self
         (run :inline (Always) [(self (ptr ~own-self)) ~@xparams] (-> ~result)
           (unsafe (let [t (load (field self tramp))] (t (load (field self at)) ~@xargs))))
         (call-once [(self ~own-self) ~@xparams] (-> ~result)
           (let [(mut g) self] (~(name+ name "::run") (mut g) ~@xargs)))))))

;;; ---- making one -----------------------------------------------------------------

;;; The closure trait TYPE names, and its own name: `(Visit i64)` is `Visit`.
(defn type-head [(type Code)] (-> Code)
  (if (primitive/code-list? type) (get type 0) type))

;;; `(lambda TYPE [CAPTURE…] [PARAM…] BODY…)`
(defn lambda [(type Code) (captures Code) (params Code) & (body Code)] (-> Code)
  (closure-marker type captures params body false))

;;; `(lambda-own TYPE [CAPTURE…] [PARAM…] BODY…)`
(defn lambda-own [(type Code) (captures Code) (params Code) & (body Code)] (-> Code)
  (closure-marker type captures params body true))

;;; `(closure-site [TYPE-view] OWN CAPTURE… (fn [NAME… PARAM…] BODY…))`: what the
;;; transform needs, in a form the compiler resolves and types as far as it can.
;;; The erased view type stands for the trait, since a trait is no type. Each
;;; capture is what the closure will hold: `(cap x)` or `(cap-mut (mut x))`, or
;;; for an owning closure `(owned x)`, the value moved in. `closure-site` is defined nowhere:
;;; the transform replaces every one.
(defn closure-marker [(type Code) (captures Code) (params Code) (body Code) (own bool)] (-> Code)
  (unless (and (primitive/code-vector? captures) (primitive/code-vector? params))
    (primitive/error "lambda: expected (lambda TYPE [CAPTURE…] [PARAM…] BODY…)"))
  (let [head (type-head type)
        witness (if (primitive/code-list? type)
                    `(~(name+ head "-view") ~@(primitive/code-slice type 1 (len type)))
                    (name+ head "-view"))
        (mut values) (primitive/code-list-new)
        (mut names) (primitive/code-list-new)]
    (for c (iter captures)
      (if own
          ;; NAME, moved in; or (NAME VALUE)
          (cond (primitive/code-sym? c)
                  (do (push! (mut values) `(owned ~c)) (push! (mut names) c))
                (and (primitive/code-list? c) (= (len c) 2) (primitive/code-sym? (get c 0)))
                  (do (push! (mut values) `(owned ~(get c 1))) (push! (mut names) (get c 0)))
                :else (primitive/error "lambda-own: a capture is NAME or (NAME VALUE), moved into the closure"))
          ;; (ref NAME), (mut NAME), or (NAME (ref PLACE)), (NAME (mut PLACE))
          (let [named (and (primitive/code-list? c) (= (len c) 2) (primitive/code-sym? (get c 0))
                           (primitive/code-list? (get c 1)))
                borrow (if named (get c 1) c)]
            (unless (and (primitive/code-list? borrow) (= (len borrow) 2)
                         (or (primitive/code-eq (get borrow 0) `ref) (primitive/code-eq (get borrow 0) `mut))
                         (or named (primitive/code-sym? (get borrow 1))))
              (primitive/error "lambda: a capture is (ref NAME), (mut NAME), (NAME (ref PLACE)) or (NAME (mut PLACE))"))
            (let [place (get borrow 1)]
              (push! (mut values) (if (primitive/code-eq (get borrow 0) `mut)
                                      `(cap-mut (mut ~place))
                                      `(cap ~place)))
              (push! (mut names) (if named (get c 0) place))))))
    `(closure-site [~witness] ~(if own `true `false) ~@values (fn [~@names ~@params] ~@body))))

;;; ---- the transform --------------------------------------------------------------

(defn head-named? [(f Code) (text (slice u8))] (-> bool)
  (and (primitive/code-list? f) (> (len f) 0) (primitive/code-sym? (get f 0))
       (= (meta/source (get f 0)) text)))

(defn marker? [(f Code)] (-> bool)
  (and (head-named? f "closure-site") (>= (len f) 4) (primitive/code-vector? (get f 1))
       (match (primitive/code-macro-of f)
         (primitive/ExpandedBy [q] (or (primitive/code-eq q `safe.fn.lambda)
                                       (primitive/code-eq q `safe.fn.lambda-own)))
         (_ false))))

;;; A template, which a macro or this transform fills in: nothing in it is code
;;; yet, so no marker in it is one.
(defn template? [(f Code)] (-> bool)
  (head-named? f "quasiquote"))

;;; The type parameters a definition form introduces: the names in a vector
;;; written before its parameters, `[T (U Bound)]`.
(defn introduced-tparams [(form Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (when (and (primitive/code-list? form) (> (len form) 0) (primitive/code-sym? (get form 0))
               (or (head-named? form "defn") (head-named? form "defn*") (head-named? form "impl")))
      (let [arrow (block :found
                    (for [i 0 (len form)]
                      (when (and (primitive/code-list? (get form i)) (head-named? (get form i) "->"))
                        (return-from :found i)))
                    (len form))]
        ;; every vector before the parameter vector names type parameters
        (for [i 1 (- arrow 1)]
          (let [part (get form i)]
            (when (primitive/code-vector? part)
              (for p (iter part)
                (cond (primitive/code-sym? p) (push! (mut out) p)
                      (and (primitive/code-list? p) (> (len p) 0) (primitive/code-sym? (get p 0)))
                        (push! (mut out) (get p 0))
                      :else 0)))))))
    `(~@out)))

(defn mentions? [(tree Code) (sym Code)] (-> bool)
  (cond (primitive/code-sym? tree) (primitive/code-eq tree sym)
        (or (primitive/code-list? tree) (primitive/code-vector? tree))
          (block :found
            (for k (iter tree) (when (mentions? k sym) (return-from :found true)))
            false)
        :else false))

(defn type-of-or-fail [(node Code) (what (slice u8))] (-> Code)
  (match (primitive/type-of node)
    (primitive/TypeIs [t] t)
    (_ (do (primitive/report node (text3 "lambda: the type of " what " is not known; a closure captures a place whose type the compiler has settled"))
           `unknown))))

;; The transform's text: Coil's own string buffers, which take raw memory.
(defn text3 [(a (slice u8)) (b (slice u8)) (c (slice u8))] (-> (slice u8))
  (unsafe
    (let [(mut sb) (StrBuf::new (meta/expansion-allocator))]
      (push-str! (mut sb) a)
      (push-str! (mut sb) b)
      (push-str! (mut sb) c)
      (str sb))))

;;; What the transform carries through a module: the forms it adds, and how
;;; many lambdas it has made.
(defstruct Made [(defs Code) (count i64) (traits Code)])

;;; The result of a definition that asked for `(some TRAIT …)` until the lambda
;;; it ends with is made: V is the erased view of TRAIT, so the definition
;;; checks, and its body's types are known.
(defstruct Asked [V] [])

;;; The lambda at the marker F, inside definitions whose type parameters are
;;; SCOPE, made a type of its own in MODULE. -> what replaces the marker.
(defn make-lambda [(f Code) (scope Code) (module Code) (made (mut Made))] (-> Code)
  (let [witness (get (get f 1) 0)
        own (primitive/code-eq (get f 2) `true)
        code (get f (- (len f) 1))
        values (primitive/code-slice f 3 (- (len f) 1))
        n (len values)
        binders (get code 1)
        names (primitive/code-slice binders 0 n)
        params (primitive/code-slice binders n (len binders))
        body (primitive/code-slice code 2 (len code))
        view-head (if (primitive/code-list? witness) (get witness 0) witness)
        view-text (meta/source view-head)
        trait-head (primitive/datum->syntax view-head
                                            (primitive/code-symbol (substr view-text 0 (- (len view-text) 5))))
        ; the closure's parameter and result types, from its erased form's
        ; function pointer: `(fnptr CC [(ptr u8) PARAM…] RESULT)`
        tramp-type (primitive/code-field-type witness 1)
        ptypes (primitive/code-slice (get tramp-type 2) 1 (len (get tramp-type 2)))
        result (get tramp-type 3)
        (mut ctypes) (primitive/code-list-new)]
    (when (!= (len params) (len ptypes))
      (primitive/report f "lambda: the closure takes as many parameters as its type says"))
    (for v (iter values)
      (let [t (type-of-or-fail v "a capture")]
        ;; a borrowed capture is a `(Cap T)` or a `(CapMut T)`, an owned one the
        ;; value `(owned x)` moves in
        (push! (mut ctypes) t)))
    (let [ctypes `(~@ctypes)
          name (primitive/datum->syntax (get module 0)
                                        (primitive/code-symbol trait-head "--lambda" (int-text (.count made))))
          ; the type parameters of the enclosing definitions this lambda uses
          tps (let [(mut out) (primitive/code-list-new)]
                (for t (iter scope)
                  (when (or (mentions? ctypes t) (mentions? ptypes t) (mentions? result t)
                            (mentions? `(~@body) t) (mentions? witness t))
                    (push! (mut out) t)))
                `(~@out))
          self (if (> (len tps) 0) `(~name ~@tps) name)
          sid (primitive/fresh-identifier "self")
          (mut fields) (primitive/code-list-new)
          (mut inits) (primitive/code-list-new)
          (mut binds) (primitive/code-list-new)
          (mut run-params) (primitive/code-list-new)
          (mut run-args) (primitive/code-list-new)]
      ;; The language's own words in what is generated are spelled in the
      ;; program's module, as the program would write them; what names this
      ;; library (`Cap::get`, `View`) keeps the template's, which reaches it.
      (let [k-mut (in-module module "mut") k-ptr (in-module module "ptr") k-field (in-module module "field") k-let (in-module module "let*") k-arrow (in-module module "->")
            k-impl (in-module module "impl") k-defstruct (in-module module "defstruct") k-void (in-module module "void") k-drop-trait (in-module module "Drop")]
      (for k (range 0 n)
        (let [fld (primitive/code-symbol "c" (int-text k))
              t (get ctypes k)
              v (get values k)
              excl (head-named? v "cap-mut")]
          (push! (mut fields) `(~fld ~t))
          (push! (mut inits) (primitive/code-symbol ":" fld))
          (push! (mut inits) v)
          ;; an owned capture's name aliases the closure's own copy
          (push! (mut binds) (if own `(~k-mut ~(get names k)) (get names k)))
          ;; inside BODY each capture is a reference: to the closure's own copy,
          ;; or to what it borrowed
          (push! (mut binds)
                 (cond own `(~k-mut (~(in-module module (meta/source (primitive/code-symbol "." fld))) ~sid))
                       excl `(CapMut::get-mut (~k-mut (~k-field ~sid ~fld)))
                       :else `(Cap::get (~k-field ~sid ~fld))))))
      (for k (range 0 (len params))
        (let [p (get params k) t (get ptypes k)]
          (push! (mut run-params) `(~p ~t))
          (push! (mut run-args) (if (head-named? t "mut") `(~k-mut ~p) p))))
      (let [gid (primitive/fresh-identifier "g")
            impl-tps (tparams tps)
            ;; what a transform gives back is never expanded again: core forms only
            run `(run :inline (Always) [(~sid (~k-ptr ~self)) ~@run-params] (~k-arrow ~result)
                   (~k-let [~@binds] ~@body))
            once `(call-once [(~sid ~self) ~@run-params] (~k-arrow ~result)
                    (~k-let [(~k-mut ~gid) ~sid] (~(primitive/datum->syntax trait-head (primitive/code-symbol trait-head "::run")) (~k-mut ~gid) ~@run-args)))
            drop-self (primitive/fresh-identifier "self")
            (mut defs) (primitive/code-list-new)]
        (push! (mut defs) `(~k-defstruct ~name ~@impl-tps [~@fields]))
        (unless own
          (push! (mut defs) `(~k-impl ~@impl-tps View ~self))
          (push! (mut defs) `(~k-impl ~@impl-tps QuietDrop ~self))
          (push! (mut defs) `(~k-impl ~@impl-tps ~k-drop-trait ~self
                               (~(in-module module "drop") [(~drop-self (~k-mut ~self))] (~k-arrow ~k-void) 0))))
        (push! (mut defs) `(~k-impl ~@impl-tps ~trait-head ~self ~run ~once))
        ;; each form is the lambda's: written where the lambda is, so it is the
        ;; program's code to a checker, and a diagnostic about it points there
        (let [(mut placed) (primitive/code-list-new)]
          (for d (iter `(~@defs)) (push! (mut placed) (primitive/code-list-like f d)))
          (set! (.defs made) `(~@(.defs made) ~@placed)))
        (set! (.count made) (+ (.count made) 1))
        (set! (.traits made) `(~@(.traits made) (~name ~witness)))
        ;; a borrowing closure is a view built from the views of its captures,
        ;; so it keeps each of them lent, as a reference to it would
        `(~name ~@impl-tps ~@inits))))))

;;; The word TEXT as the module record MODULE's own code would spell it.
(defn in-module [(module Code) (text (slice u8))] (-> Code)
  (primitive/datum->syntax (get module 0) (primitive/code-symbol text)))

;;; N, not negative, in decimal.
(defn int-text [(n i64)] (-> (slice u8))
  (unsafe
    (let [(mut sb) (StrBuf::new (meta/expansion-allocator))]
      (push-digits! (mut sb) n)
      (str sb))))

(defn push-digits! [(sb (mut StrBuf)) (n i64)] (-> void)
  (unsafe
    (when (>= n 10) (push-digits! (mut sb) (/ n 10)))
    (let [d (% n 10)]
      (push-str! (mut sb) (substr "0123456789" d (+ d 1))))
    0))

;;; F with every marker in it replaced, inside definitions whose type
;;; parameters are SCOPE.
(defn rewrite [(f Code) (scope Code) (module Code) (made (mut Made))] (-> Code)
  (cond (marker? f) (make-lambda f scope module (mut made))
        (template? f) f
        (some-asked? f) (ask-some f)
        (or (primitive/code-list? f) (primitive/code-vector? f))
          (if (or (has-marker? f) (asks-some? f))
              (let [inner `(~@scope ~@(introduced-tparams f))
                    (mut kids) (primitive/code-list-new)]
                (for k (iter f) (push! (mut kids) (rewrite k inner module (mut made))))
                (let [out (primitive/code-list-like f `(~@kids))]
                  (if (> (len (some-recorded out)) 0) (give-some out module made) out)))
              f)
        :else f))

;;; ---- a lambda returned as itself ------------------------------------------------
;;;
;;; `(defn f [...] (-> (some TRAIT ARG…)) … (lambda TRAIT …))`: F returns the
;;; lambda it ends with as the type of its own the lambda is given, so what it
;;; returns is called directly, as by a function generic over the closure it is
;;; given, and nothing is erased; only this transform names the type. A body's
;;; types are known only once its signature checks, so `(some …)` is first the
;;; erased view of TRAIT, as `(Asked TRAIT-view …)`, and once the lambda is made
;;; it is the lambda's type.

;;; Is F, or a form directly in F, a definition that asks for `(some …)`, or one
;;; whose `(Asked …)` is not yet a lambda's type? A module whose only lambda is
;;; missing still has its `(some …)` asked for, and refused.
(defn asks-some? [(f Code)] (-> bool)
  (or (some-asked? f) (> (len (some-recorded f)) 0)
      (and (primitive/code-list? f)
           (block :found
             (for k (iter f)
               (when (or (some-asked? k) (> (len (some-recorded k)) 0)) (return-from :found true)))
             false))))

;;; The index of the `(-> R)` of the definition F, or -1.
(defn arrow-at [(f Code)] (-> i64)
  (block :found
    (for [i 2 (len f)]
      (when (head-named? (get f i) "->") (return-from :found i)))
    -1))

;;; Is F a definition whose result is written `(some TRAIT ARG…)`?
(defn some-asked? [(f Code)] (-> bool)
  (and (head-named? f "defn*")
       (let [at (arrow-at f)]
         (and (> at 0) (= (len (get f at)) 2) (head-named? (get (get f at) 1) "some")
              (> (len (get (get f at) 1)) 1)))))

;;; F with its result `(Asked TRAIT-view ARG…)`; its lambdas are made once its
;;; body checks.
(defn ask-some [(f Code)] (-> Code)
  (let [at (arrow-at f)
        arrow (get f at)
        asked (get arrow 1)
        trait (get asked 1)
        args (primitive/code-slice asked 2 (len asked))
        view (primitive/datum->syntax trait (primitive/code-symbol trait "-view"))
        result `(Asked ~(if (> (len args) 0) `(~view ~@args) view))
        (mut parts) (primitive/code-list-new)]
    (for [i 0 (len f)]
      (push! (mut parts)
             (if (= i at) (primitive/code-list-like arrow `(~(get arrow 0) ~result)) (get f i))))
    (primitive/code-list-like f `(~@parts))))

;;; The view the definition F asked for, `(V)` of a result `(Asked V)`, or `()`.
(defn some-recorded [(f Code)] (-> Code)
  (let [at (if (head-named? f "defn*") (arrow-at f) -1)]
    (if (and (> at 0) (= (len (get f at)) 2))
        (let [r (get (get f at) 1)]
          ;; the Asked this transform wrote: its own template's identifier
          (if (and (primitive/code-list? r) (= (len r) 2) (primitive/code-sym? (get r 0))
                   (primitive/free-identifier=? (get r 0) `Asked))
              `(~(get r 1))
              `()))
        `())))

;;; The qualified name of the type the head of T, a type, names.
(defn type-head-name [(t Code)] (-> Code)
  (match (primitive/code-decl (if (primitive/code-list? t) (get t 0) t))
    (primitive/Declared [_ _ q _] q)
    (_ `())))

;;; The expression F ends with: the last form of its body, and of a `let*` or a
;;; `do` there.
(defn tail-of [(e Code)] (-> Code)
  (if (and (or (head-named? e "let*") (head-named? e "do")) (> (len e) 1))
      (tail-of (get e (- (len e) 1)))
      e))

;;; The definition F, whose lambdas are made, with its result the type of the
;;; lambda it ends with, which implements the trait `:safe/some` names.
(defn give-some [(f Code) (module Code) (made (ref Made))] (-> Code)
  (let [at (arrow-at f)
        tail (tail-of (get f (- (len f) 1)))
        made-as (block :found
                  (when (and (primitive/code-list? tail) (> (len tail) 0) (primitive/code-sym? (get tail 0)))
                    (for pr (iter (.traits made))
                      (when (primitive/code-eq (get pr 0) (get tail 0)) (return-from :found pr))))
                  `())]
    (if (= (len made-as) 0)
        (do (primitive/report f "safe: (some TRAIT) is the type of the lambda a function ends with, and this one ends with something else")
            f)
        (let [asked (get (some-recorded f) 0)
              same (and (primitive/code-sym? (type-head-name asked))
                        (primitive/code-eq (type-head-name asked) (type-head-name (get made-as 1))))
              name (get tail 0)
              result (if (and (> (len tail) 1) (primitive/code-vector? (get tail 1)))
                         `(~name ~@(get tail 1))
                         name)
              arrow (get f at)
              (mut parts) (primitive/code-list-new)]
          (unless same
            (primitive/report f "safe: the lambda this function ends with is not of the trait its (some …) names"))
          (for [i 0 (len f)]
            (push! (mut parts)
                   (if (= i at) (primitive/code-list-like arrow `(~(get arrow 0) ~result)) (get f i))))
          (primitive/code-list-like f `(~@parts))))))

(defn has-marker? [(f Code)] (-> bool)
  (cond (marker? f) true
        (template? f) false
        (or (primitive/code-list? f) (primitive/code-vector? f))
          (block :found
            (for k (iter f) (when (has-marker? k) (return-from :found true)))
            false)
        :else false))

;;; Give each lambda in the program a type of its own. A module's lambdas are
;;; made in the order they are written; the names of their types count up from
;;; how many that module already has.
(defn closures [(modules Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for m (iter modules)
      (if (or (has-marker? m) (asks-some? m))
          (let [(mut made) (Made :defs `() :count (lambdas-in m) :traits `())
                r (rewrite m `() m (mut made))]
            (push! (mut out) `(~@r ~@(.defs made))))
          (push! (mut out) m)))
    `(~@out)))

;;; How many lambda types the module already has: forms `(defstruct X--lambdaN …)`.
(defn lambdas-in [(m Code)] (-> i64)
  (let [(mut n) 0]
    (for f (iter m)
      (when (and (head-named? f "defstruct") (> (len f) 1) (primitive/code-sym? (get f 1))
                 (contains? (meta/source (get f 1)) "--lambda"))
        (set! n (+ n 1))))
    n))

(defn contains? [(text (slice u8)) (part (slice u8))] (-> bool)
  (unsafe
    (block :found
      (for [i 0 (+ (- (len text) (len part)) 1)]
        (when (= (substr text i (+ i (len part))) part) (return-from :found true)))
      false)))

(transform closures :modules (phase/OwnModules))
