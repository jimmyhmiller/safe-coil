;;; What safe Coil code is written with besides the language itself.
(module safe.core)
(import "coil.primitive" :as primitive)
(import "coil.meta" :as meta)

;;; `(defn f :safe/borrows "a b" [(a (ref T)) (b (ref U)) (c (ref V))] (-> (ref W)) …)`:
;;; the reference f returns borrows only from what the parameters named were lent,
;;; not from every reference argument. The checker holds the body to it, and a
;;; call keeps only those arguments lent while the result lives.
(defannotation :safe/borrows (slice u8))

;;; `(unsafe FORM…)`: the forms may follow raw memory. Every other rule still
;;; applies inside. The checker recognizes the `do` this expands to by the macro
;;; that produced it.
(defn unsafe [(first Code) & (rest Code)] (-> Code)
  `(do ~first ~@rest))

;;; What SLOT points at, lent. A raw pointer passed for a reference parameter is
;;; the reference to its pointee, so only `unsafe` code can call these with one.
(defn lend [T] [(slot (ref T))] (-> (ref T)) slot)

(defn lend-mut [T] [(slot (mut T))] (-> (mut T)) slot)

;;; Put VALUE in SLOT and give back what was there. The way to take an owner out
;;; of a field, a box or a pool element, which cannot be moved out of.
(defn replace! [T] [(slot (mut T)) (value T)] (-> T)
  (unsafe
    (let [raw (primitive/cast (ptr T) (mut slot))
          old (take! [T] raw)]
      (store! raw value)
      old)))

;;; PLACE, lent: a reference to it as a value, for a `let` or a result.
(defn borrow [T] [(place (ref T))] (-> (ref T)) place)

;;; PLACE, lent exclusively: `(borrow-mut (mut place))`.
(defn borrow-mut [T] [(place (mut T))] (-> (mut T)) place)

;;; VALUE, as a temporary. `(match (move x) …)` consumes x, so each arm owns what
;;; it binds; a match on a name lends an owned payload to its arm instead.
(defn move [T] [(value T)] (-> T) value)

;;; A view: a struct that stands for the references it was made from, as a slice
;;; of a list or a held lock does. `(impl View TYPE)` marks one. The checker then
;;; treats a TYPE as it treats a reference: a call that returns one keeps what it
;;; took by reference lent for as long as the view lives, and a view is a local,
;;; an argument or a result, never stored. What a view holds inside is raw
;;; memory its own module follows.
(deftrait View [Self])

;;; A view whose drop does nothing with what it borrowed: it has a `Drop` only so
;;; that naming it moves it. `(impl QuietDrop TYPE)` lets its loans end at its
;;; last use, as a reference's do; a view without it keeps them until its scope
;;; ends, since its drop may still use them.
(deftrait QuietDrop [Self])

;;; `(impl SharedView TYPE)`: a view that gives only shared access to what it
;;; was made from, however that was lent. Such a view can be copied even when
;;; made from an exclusive reference, as `fn get(&mut self) -> Option<&V>`'s
;;; result is: every copy keeps the loan, and none changes anything. Only the
;;; module that declares TYPE may say it.
(deftrait SharedView [Self])

;;; `(impl CrossThread TYPE)`: a view that may be lent to the other thread of a
;;; `par` call. A view tied to the thread it was made on, as a held lock is, does
;;; not say it. Only the module that declares TYPE may say it.
(deftrait CrossThread [Self])

;;; A collection whose elements are reached by position: `count` of them, and
;;; `item` lends the one at I. An index out of range stops the program.
(deftrait Each [Self Item]
  (count [(xs (ref Self))] (-> i64))
  (item [(xs (ref Self)) (i i64)] (-> (ref Item))))

;;; A collection whose elements can be changed where they are.
(deftrait EachMut [Self Item]
  (item-mut [(xs (mut Self)) (i i64)] (-> (mut Item))))

;;; ---- run-time checks that fail -------------------------------------------------
;;;
;;; Each stops the program with a message. None is inlined: the check that calls
;;; one stays a compare and a branch where it is made, so what it guards can be
;;; inlined, hoisted and vectorized around it.

(defn stop-index :inline (Never) [(i i64) (what (slice u8)) (n i64)] (-> never)
  (panic "safe: index {} is out of range for {} of {}" i what n))

(defn stop-range :inline (Never) [(from i64) (to i64) (n i64)] (-> never)
  (panic "safe: the range {} to {} is not inside {} elements" from to n))

(defn stop :inline (Never) [(message (slice u8))] (-> never)
  (panic "safe: {}" message))

;;; ---- Coil's slices, read safely ----------------------------------------------
;;;
;;; Safe code meets a `(slice T)` only as a string literal, or as a parameter
;;; given one: memory that lives as long as the program and is never changed.
;;; Coil's own `get` checks an index only under `--debug-checks`, so a slice is
;;; read through these, which check every one.

;;; How many elements S has.
(defn size :inline (Always) [T] [(s (slice T))] (-> i64)
  (unsafe (len s)))

;;; A copy of element I of S. An index out of range stops the program.
(defn nth :inline (Always) [T] [(s (slice T)) (i i64)] (-> T)
  (unsafe
    (when (or (< i 0) (>= i (len s)))
      (stop-index i "a slice" (len s)))
    (get s i)))

(impl [T] Each (slice T)
  (count [(xs (ref (slice T)))] (-> i64)
    (unsafe (len (load (primitive/cast (ptr (slice T)) xs)))))
  (item [(xs (ref (slice T))) (i i64)] (-> (ref T))
    (unsafe
      (let [s (load (primitive/cast (ptr (slice T)) xs))]
        (when (or (< i 0) (>= i (len s)))
          (stop-index i "a slice" (len s)))
        (lend (primitive/index (data s) i))))))

;;; Is XS a name, or a field of one: a place `each` can name again and again?
(defn place-form? [(xs Code)] (-> bool)
  (cond (primitive/code-sym? xs) true
        (and (primitive/code-list? xs) (> (len xs) 1) (primitive/code-sym? (get xs 0)))
          (let [h (meta/source (get xs 0))]
            (cond (= h "field") (place-form? (get xs 1))
                  (= h "..") (place-form? (get xs 1))
                  (and (> (len h) 1) (= (get h 0) #\.) (= (len xs) 2)) (place-form? (get xs 1))
                  :else false))
        :else false))

;;; `(each [NAME XS] BODY…)`: BODY once for every element of XS, in order, with
;;; NAME a reference to the element. XS names a place; it is lent for the whole
;;; of each turn, and BODY cannot add to it or take from it.
(defn each [(binding Code) & (body Code)] (-> Code)
  (unless (and (primitive/code-vector? binding) (= (len binding) 2))
    (primitive/error "each: expected (each [name collection] body…)"))
  (if (place-form? (get binding 1))
      `(let [total (Each::count ~(get binding 1))]
         (for i (range 0 total)
           (let [~(get binding 0) (Each::item ~(get binding 1) i)]
             ~@body)))
      ; anything else is evaluated once, and the loop runs over what it gave
      (let [xs (primitive/fresh-identifier "collection")]
        `(let [~xs ~(get binding 1)]
           (each [~(get binding 0) ~xs] ~@body)))))

;;; `(each-mut [NAME XS] BODY…)`: as `each`, with NAME an exclusive reference to
;;; the element, to change it. XS names a place that can be changed.
(defn each-mut [(binding Code) & (body Code)] (-> Code)
  (unless (and (primitive/code-vector? binding) (= (len binding) 2))
    (primitive/error "each-mut: expected (each-mut [name collection] body…)"))
  (if (place-form? (get binding 1))
      `(let [total (Each::count ~(get binding 1))]
         (for i (range 0 total)
           (let [~(get binding 0) (EachMut::item-mut (mut ~(get binding 1)) i)]
             ~@body)))
      (let [xs (primitive/fresh-identifier "collection")]
        `(let [(mut ~xs) ~(get binding 1)]
           (each-mut [~(get binding 0) ~xs] ~@body)))))
