;;; A growable list that owns its elements.
(module safe.vec)
(export Vec VecIn Slice SliceMut Halves)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "safe.core" :use [unsafe lend lend-mut View Each EachMut SharedView CrossThread stop-index stop-range Droppable])
(import "safe.alloc" :use [Alloc InArena Heap Arena ArenaRef room-in release-in])

;;; A list of T, in memory from A (see safe.alloc). It owns its elements: they
;;; are freed with it. An index out of range stops the program. A list in an
;;; arena, `(VecIn T ArenaRef)`, is a view: it keeps the arena lent while it
;;; lives.
(defstruct VecIn [T A] [(items (slice T)) (count i64) (alloc A)])

(impl [T] View (VecIn T ArenaRef))

;;; What a list in an arena holds owns nothing, and is not dropped.
(impl [T] InArena (VecIn T ArenaRef))

;;; A list of T on the heap: `(VecIn T Heap)`, which it holds, with the same
;;; methods.
(defstruct Vec [T] [(in (VecIn T Heap))])

;;; Part of a list, lent shared: `count` elements from `items`. It is a view: the
;;; list stays lent for as long as the slice lives, so it cannot grow or be
;;; freed under it.
(defstruct Slice [T] [(items (ptr T)) (count i64)])

(impl [T] View (Slice T))

(impl [T] SharedView (Slice T))

(impl [T] CrossThread (Slice T))

;;; Part of a list, lent exclusively: its elements can be changed through it. While
;;; it lives nothing else reaches the list. It is a view, and it is moved, never
;;; copied: two of them would be two ways to change the same elements.
(defstruct SliceMut [T] [(items (ptr T)) (count i64)])

(impl [T] View (SliceMut T))

(impl [T] CrossThread (SliceMut T))

;;; Two parts of one slice, each lent exclusively, at once: `left` and `right`
;;; are fields, so separate places, and `(mut (field h left))` and `(mut (field h
;;; right))` can be held together, as `par` does. The slice they came from stays
;;; lent while the Halves live. It is moved, never copied.
(defstruct Halves [T] [(left (SliceMut T)) (right (SliceMut T))])

(impl [T] View (Halves T))

(impl [T] CrossThread (Halves T))

(impl [T] Drop (SliceMut T)
  (drop [(self (mut (SliceMut T)))] (-> void) 0))

;;; Where element I of the COUNT at ITEMS is. An index out of range stops the
;;; program.
(defn within :inline (Always) [T] [(items (ptr T)) (count i64) (i i64)] (-> (ptr T))
  (unsafe
    (when (or (< i 0) (>= i count))
      (stop-index i "a slice" count))
    (primitive/index items i)))

;;; Where the elements FROM up to TO of the COUNT at ITEMS start. A range that is
;;; not inside them stops the program.
(defn range-within :inline (Always) [T] [(items (ptr T)) (count i64) (from i64) (to i64)] (-> (ptr T))
  (unsafe
    (when (or (< from 0) (> to count) (> from to))
      (stop-range from to count))
    (primitive/index items from)))

;;; No room at all: a list takes its first room when something is put in it.
(defn empty :inline (Always) [T] [] (-> (slice T))
  (unsafe (slice::new [T] (primitive/cast (ptr T) (primitive/alignof T)) 0)))

;;; Where element I of V is. An index out of range stops the program.
(defn slot :inline (Always) [T A] [(v (ref (VecIn T A))) (i i64)] (-> (ptr T))
  (unsafe
    (when (or (< i 0) (>= i (.count v)))
      (stop-index i "a Vec" (.count v)))
    (primitive/index (data (.items v)) i)))

(impl [(T Droppable) (A Alloc)] (VecIn T A)
  ;;; An empty list in memory from A: the heap (`Heap`) or a Lease. A list in
  ;;; an arena is made by `VecIn::in-arena`.
  (new-in [(a A)] (-> (VecIn T A))
    (unsafe (VecIn :items (empty [T]) :count 0 :alloc a)))

  ;;; How many elements it holds.
  (len :inline (Always) [(v (ref (VecIn T A)))] (-> i64)
    (.count v))

  ;;; Add VALUE at the end.
  (push! [(v (mut (VecIn T A))) (value T)] (-> void)
    (unsafe
      (when (= (.count v) (len (.items v)))
        (let [bigger (room-in [T A] (field v alloc) (if (= (len (.items v)) 0) 4 (* 2 (len (.items v)))))]
          (for i (range 0 (.count v))
            (store! (primitive/index (data bigger) i)
                    (take! [T] (primitive/index (data (.items v)) i))))
          (release-in [T A] (field v alloc) (.items v))
          (set! (.items v) bigger)))
      (store! (primitive/index (data (.items v)) (.count v)) value)
      (set! (.count v) (+ (.count v) 1))
      0))

  ;;; Take the last element off, or None when there is none.
  (pop! [(v (mut (VecIn T A)))] (-> (Option T))
    (unsafe
      (if (= (.count v) 0)
          (None [T])
          (do (set! (.count v) (- (.count v) 1))
              (Some (take! [T] (primitive/index (data (.items v)) (.count v))))))))

  ;;; Exchange elements I and J. An index out of range stops the program.
  (swap! [(v (mut (VecIn T A))) (i i64) (j i64)] (-> void)
    (unsafe
      (let [a (slot v i)
            b (slot v j)]
        (unless (= i j)
          (let [held (take! [T] a)]
            (store! a (take! [T] b))
            (store! b held)))
        0)))

  ;;; Put VALUE at I, moving the elements from I on one place later. I may be
  ;;; the length, which adds VALUE at the end.
  (insert! [(v (mut (VecIn T A))) (i i64) (value T)] (-> void)
    (unsafe
      (when (or (< i 0) (> i (.count v)))
        (stop-index i "inserting into a Vec" (.count v)))
      (VecIn::push! (mut v) value)
      (let [(mut k) (- (.count v) 1)]
        (while (> k i)
          (VecIn::swap! (mut v) k (- k 1))
          (set! k (- k 1))))
      0))

  ;;; Take element I out, moving the elements after it one place earlier. An
  ;;; index out of range stops the program.
  (remove! [(v (mut (VecIn T A))) (i i64)] (-> T)
    (unsafe
      (slot v i)
      (let [(mut k) i]
        (while (< k (- (.count v) 1))
          (VecIn::swap! (mut v) k (+ k 1))
          (set! k (+ k 1))))
      (set! (.count v) (- (.count v) 1))
      (take! [T] (primitive/index (data (.items v)) (.count v)))))

  ;;; Drop every element, keeping the room.
  (clear! [(v (mut (VecIn T A)))] (-> void)
    (while (> (VecIn::len v) 0)
      (VecIn::pop! (mut v)))
    0)

  ;;; Element I, lent for as long as the list is.
  (at :inline (Always) [(v (ref (VecIn T A))) (i i64)] (-> (ref T))
    (unsafe (lend (slot v i))))

  ;;; Element I, lent to be changed for as long as the list is.
  (at-mut :inline (Always) [(v (mut (VecIn T A))) (i i64)] (-> (mut T))
    (unsafe (lend-mut (slot v i))))

  ;;; The elements from FROM up to TO, lent shared. A range that is not inside
  ;;; the list stops the program.
  (slice [(v (ref (VecIn T A))) (from i64) (to i64)] (-> (Slice T))
    (unsafe
      (Slice :items (range-within (data (.items v)) (.count v) from to) :count (- to from))))

  ;;; The elements from FROM up to TO, lent to be changed.
  (slice-mut [(v (mut (VecIn T A))) (from i64) (to i64)] (-> (SliceMut T))
    (unsafe
      (SliceMut :items (range-within (data (.items v)) (.count v) from to) :count (- to from)))))


;;; An empty list in ARENA, which stays lent while the list lives.
(impl [(T Droppable)] (VecIn T ArenaRef)
  (in-arena [(arena (ref Arena))] (-> (VecIn T ArenaRef))
    (unsafe (VecIn :items (empty [T]) :count 0 :alloc (Arena::lend arena)))))

(impl [(T Droppable)] (Vec T)
  ;;; An empty list.
  (new :inline (Always) [] (-> (Vec T))
    (Vec :in (VecIn::new-in [T Heap] (Heap))))

  (len :inline (Always) [(v (ref (Vec T)))] (-> i64) (VecIn::len (field v in)))

  (push! :inline (Always) [(v (mut (Vec T))) (value T)] (-> void)
    (VecIn::push! (mut (field v in)) value))

  (pop! :inline (Always) [(v (mut (Vec T)))] (-> (Option T))
    (VecIn::pop! (mut (field v in))))

  (swap! :inline (Always) [(v (mut (Vec T))) (i i64) (j i64)] (-> void)
    (VecIn::swap! (mut (field v in)) i j))

  (insert! :inline (Always) [(v (mut (Vec T))) (i i64) (value T)] (-> void)
    (VecIn::insert! (mut (field v in)) i value))

  (remove! :inline (Always) [(v (mut (Vec T))) (i i64)] (-> T)
    (VecIn::remove! (mut (field v in)) i))

  (clear! :inline (Always) [(v (mut (Vec T)))] (-> void)
    (VecIn::clear! (mut (field v in))))

  (at :inline (Always) [(v (ref (Vec T))) (i i64)] (-> (ref T))
    (VecIn::at (field v in) i))

  (at-mut :inline (Always) [(v (mut (Vec T))) (i i64)] (-> (mut T))
    (VecIn::at-mut (mut (field v in)) i))

  (slice :inline (Always) [(v (ref (Vec T))) (from i64) (to i64)] (-> (Slice T))
    (VecIn::slice (field v in) from to))

  (slice-mut :inline (Always) [(v (mut (Vec T))) (from i64) (to i64)] (-> (SliceMut T))
    (VecIn::slice-mut (mut (field v in)) from to)))

(impl [T] (Slice T)
  ;;; How many elements it covers.
  (len :inline (Always) [(s (ref (Slice T)))] (-> i64)
    (.count s))

  ;;; Element I of the slice. An index out of range stops the program.
  (at :inline (Always) [(s (ref (Slice T))) (i i64)] (-> (ref T))
    (unsafe (lend [T] (within (.items s) (.count s) i))))

  ;;; The elements of the slice from FROM up to TO.
  (part [(s (ref (Slice T))) (from i64) (to i64)] (-> (Slice T))
    (unsafe
      (Slice :items (range-within (.items s) (.count s) from to) :count (- to from)))))

(impl [T] (SliceMut T)
  ;;; How many elements it covers.
  (len :inline (Always) [(s (ref (SliceMut T)))] (-> i64)
    (.count s))

  ;;; Element I of the slice. An index out of range stops the program.
  (at :inline (Always) [(s (ref (SliceMut T))) (i i64)] (-> (ref T))
    (unsafe (lend [T] (within (.items s) (.count s) i))))

  ;;; Element I of the slice, to be changed.
  (at-mut :inline (Always) [(s (mut (SliceMut T))) (i i64)] (-> (mut T))
    (unsafe (lend-mut [T] (within (.items s) (.count s) i))))

  ;;; The elements of the slice from FROM up to TO, lent shared.
  (part [(s (ref (SliceMut T))) (from i64) (to i64)] (-> (Slice T))
    (unsafe
      (Slice :items (range-within (.items s) (.count s) from to) :count (- to from))))

  ;;; A copy of element I, for an element of plain data.
  (get :inline (Always) :collection/copies-element "(SliceMut::at s i)" [(s (ref (SliceMut T))) (i i64)] (-> T)
    (unsafe (load (within (.items s) (.count s) i))))

  ;;; The elements before MID and from MID on, both to be changed, as Halves.
  ;;; MID outside the slice stops the program.
  (split [(s (mut (SliceMut T))) (mid i64)] (-> (Halves T))
    (unsafe
      (when (or (< mid 0) (> mid (.count s)))
        (stop-range 0 mid (.count s)))
      (Halves :left (SliceMut :items (.items s) :count mid)
              :right (SliceMut :items (primitive/index (.items s) mid) :count (- (.count s) mid)))))

  ;;; The elements of the slice from FROM up to TO, to be changed. This slice is
  ;;; lent to the new one for as long as it lives.
  (part-mut [(s (mut (SliceMut T))) (from i64) (to i64)] (-> (SliceMut T))
    (unsafe
      (SliceMut :items (range-within (.items s) (.count s) from to) :count (- to from)))))

;;; `(len v)`, as for Coil's own collections.
(impl [(T Droppable) (A Alloc)] Len (VecIn T A)
  (len :inline (Always) [(v (ref (VecIn T A)))] (-> i64) (.count v)))

(impl [(T Droppable)] Len (Vec T)
  (len :inline (Always) [(v (ref (Vec T)))] (-> i64) (.count (field v in))))

;;; `(get v i)`: a copy of element I, for elements that are plain data; one
;;; that owns something is lent with `(Vec::at v i)`.
(impl [(T Droppable) (A Alloc)] Get (VecIn T A)
  (get :inline (Always) :collection/copies-element "(VecIn::at v i)" [(v (ref (VecIn T A))) (i i64)] (-> T)
    (unsafe (load (slot v i)))))

(impl [(T Droppable)] Get (Vec T)
  (get :inline (Always) :collection/copies-element "(Vec::at v i)" [(v (ref (Vec T))) (i i64)] (-> T)
    (unsafe (load (slot (field v in) i)))))

;;; `(set! (mut v) i x)`: element I replaced, the old one dropped.
(impl [(T Droppable) (A Alloc)] Set (VecIn T A)
  (set! [(v (mut (VecIn T A))) (i i64) (x T)] (-> i64)
    (set! (VecIn::at-mut (mut v) i) x)
    0))

(impl [(T Droppable)] Set (Vec T)
  (set! [(v (mut (Vec T))) (i i64) (x T)] (-> i64)
    (set! (Vec::at-mut (mut v) i) x)
    0))

;;; `(clone v)`: a new list of the elements' clones.
(impl [(T Clone Droppable)] Clone (Vec T)
  (clone [(v (ref (Vec T)))] (-> (Vec T))
    (let [(mut out) (Vec::new [T])]
      (for i (range 0 (Vec::len v))
        (Vec::push! (mut out) (clone (Vec::at v i))))
      out)))

(impl [(T Droppable) (A Alloc)] Each (VecIn T A)
  (count :inline (Always) [(xs (ref (VecIn T A)))] (-> i64) (VecIn::len xs))
  (item :inline (Always) [(xs (ref (VecIn T A))) (i i64)] (-> (ref T)) (VecIn::at xs i)))

(impl [(T Droppable) (A Alloc)] EachMut (VecIn T A)
  (item-mut :inline (Always) [(xs (mut (VecIn T A))) (i i64)] (-> (mut T)) (VecIn::at-mut (mut xs) i)))

(impl [(T Droppable)] Each (Vec T)
  (count :inline (Always) [(xs (ref (Vec T)))] (-> i64) (Vec::len xs))
  (item :inline (Always) [(xs (ref (Vec T))) (i i64)] (-> (ref T)) (Vec::at xs i)))

(impl [(T Droppable)] EachMut (Vec T)
  (item-mut :inline (Always) [(xs (mut (Vec T))) (i i64)] (-> (mut T)) (Vec::at-mut (mut xs) i)))

(impl [T] Each (Slice T)
  (count [(xs (ref (Slice T)))] (-> i64) (Slice::len xs))
  (item [(xs (ref (Slice T))) (i i64)] (-> (ref T)) (Slice::at xs i)))

(impl [T] Each (SliceMut T)
  (count [(xs (ref (SliceMut T)))] (-> i64) (SliceMut::len xs))
  (item [(xs (ref (SliceMut T))) (i i64)] (-> (ref T)) (SliceMut::at xs i)))

(impl [T] EachMut (SliceMut T)
  (item-mut [(xs (mut (SliceMut T))) (i i64)] (-> (mut T)) (SliceMut::at-mut (mut xs) i)))

(impl [(T Droppable) (A Alloc)] Drop (VecIn T A)
  (drop [(self (mut (VecIn T A)))] (-> void)
    (unsafe
      (when (drops? (field self alloc))
        (for i (range 0 (.count self))
          (let [value (take! [T] (primitive/index (data (.items self)) i))] 0)))
      (release-in [T A] (field self alloc) (.items self))
      0)))
