;;; Graphs: a generic binary heap, Dijkstra's shortest paths, a topological
;;; order, and connected components by union-find. Safe Coil throughout.
;;;
;;;   coil run examples/graph.coil --use safe.check
(module example.graph)
(import "safe.vec" :use [Vec])
(import "safe.core" :use [replace!])
(import "safe.loop" :use [for])

;; ---- a binary heap -------------------------------------------------------------

;;; The smallest element first, by `<`.
(defstruct Heap [T] [(items (Vec T))])

(impl [(T Ord)] (Heap T)
  (new [] (-> (Heap T))
    (Heap :items (Vec::new [T])))

  (len [(h (ref (Heap T)))] (-> i64)
    (Vec::len (field h items)))

  (push! [(h (mut (Heap T))) (value T)] (-> void)
    (Vec::push! (mut (field h items)) value)
    (let [(mut i) (- (Vec::len (field h items)) 1)]
      (while (> i 0)
        (let [parent (/ (- i 1) 2)]
          (if (< (Vec::at (field h items) i) (Vec::at (field h items) parent))
              (do (Vec::swap! (mut (field h items)) i parent)
                  (set! i parent))
              (set! i 0))))))

  (pop! [(h (mut (Heap T)))] (-> (Option T))
    (let [n (Vec::len (field h items))]
      (if (= n 0)
          (None)
          (do
            (Vec::swap! (mut (field h items)) 0 (- n 1))
            (let [top (Vec::pop! (mut (field h items)))
                  m (- n 1)
                  (mut i) 0]
              (loop
                (let [l (+ (* 2 i) 1)
                      r (+ (* 2 i) 2)
                      (mut least) i]
                  (when (and (< l m) (< (Vec::at (field h items) l) (Vec::at (field h items) least)))
                    (set! least l))
                  (when (and (< r m) (< (Vec::at (field h items) r) (Vec::at (field h items) least)))
                    (set! least r))
                  (when (= least i) (break))
                  (Vec::swap! (mut (field h items)) i least)
                  (set! i least)))
              top))))))

;; ---- graphs --------------------------------------------------------------------

(defstruct Edge [(to i64) (weight i64)])

(defstruct Graph [(edges (Vec (Vec Edge)))])

(defn graph [(n i64)] (-> Graph)
  (let [(mut edges) (Vec::new [(Vec Edge)])]
    (for i (range 0 n) (Vec::push! (mut edges) (Vec::new [Edge])))
    (Graph :edges edges)))

(defn add-edge! [(g (mut Graph)) (from i64) (to i64) (weight i64)] (-> void)
  (Vec::push! (mut (Vec::at-mut (mut (field g edges)) from)) (Edge :to to :weight weight)))

(defn size [(g (ref Graph))] (-> i64)
  (Vec::len (field g edges)))

;;; A distance and the node it reaches, ordered by distance.
(defstruct Reach [(dist i64) (node i64)])

(impl Eq Reach
  (= [(a (ref Reach)) (b (ref Reach))] (-> bool) (= (.dist a) (.dist b))))

(impl Ord Reach
  (< [(a (ref Reach)) (b (ref Reach))] (-> bool) (< (.dist a) (.dist b)))
  (<= [(a (ref Reach)) (b (ref Reach))] (-> bool) (<= (.dist a) (.dist b)))
  (> [(a (ref Reach)) (b (ref Reach))] (-> bool) (> (.dist a) (.dist b)))
  (>= [(a (ref Reach)) (b (ref Reach))] (-> bool) (>= (.dist a) (.dist b))))

(defn dijkstra [(g (ref Graph)) (start i64)] (-> (Vec i64))
  (let [(mut dist) (Vec::new [i64])
        (mut heap) (Heap::new [Reach])]
    (for i (range 0 (size g)) (Vec::push! (mut dist) -1))
    (set! (mut dist) start 0)
    (Heap::push! (mut heap) (Reach :dist 0 :node start))
    (while (> (Heap::len heap) 0)
      (match (Heap::pop! (mut heap))
        (Some [r]
              (when (= (.dist r) (get dist (.node r)))
                (for (ref e) (Vec::at (field g edges) (.node r))
                  (let [d (+ (.dist r) (.weight e))
                        old (get dist (.to e))]
                    (when (or (< old 0) (< d old))
                      (set! (mut dist) (.to e) d)
                      (Heap::push! (mut heap) (Reach :dist d :node (.to e))))))))
        (None [] 0)))
    dist))

;;; The nodes in an order where every edge goes forward, or nothing if there is a
;;; cycle.
(defn topological [(g (ref Graph))] (-> (Option (Vec i64)))
  (let [n (size g)
        (mut indegree) (Vec::new [i64])
        (mut ready) (Vec::new [i64])
        (mut order) (Vec::new [i64])]
    (for i (range 0 n) (Vec::push! (mut indegree) 0))
    (for (ref out) (field g edges)
      (for (ref e) out
        (set! (mut indegree) (.to e) (+ (get indegree (.to e)) 1))))
    (for i (range 0 n)
      (when (= (get indegree i) 0) (Vec::push! (mut ready) i)))
    (while (> (Vec::len ready) 0)
      (match (Vec::pop! (mut ready))
        (Some [node]
              (Vec::push! (mut order) node)
              (for (ref e) (Vec::at (field g edges) node)
                (let [left (- (get indegree (.to e)) 1)]
                  (set! (mut indegree) (.to e) left)
                  (when (= left 0) (Vec::push! (mut ready) (.to e))))))
        (None [] 0)))
    (if (= (Vec::len order) n) (Some order) (None))))

;; ---- union-find ----------------------------------------------------------------

(defstruct Sets [(parent (Vec i64)) (rank (Vec i64))])

(defn sets [(n i64)] (-> Sets)
  (let [(mut parent) (Vec::new [i64])
        (mut rank) (Vec::new [i64])]
    (for i (range 0 n)
      (Vec::push! (mut parent) i)
      (Vec::push! (mut rank) 0))
    (Sets :parent parent :rank rank)))

(defn find! [(s (mut Sets)) (x i64)] (-> i64)
  (let [p (get (field s parent) x)]
    (if (= p x)
        x
        (let [root (find! (mut s) p)]
          (set! (mut (field s parent)) x root)
          root))))

(defn union! [(s (mut Sets)) (a i64) (b i64)] (-> bool)
  (let [ra (find! (mut s) a)
        rb (find! (mut s) b)]
    (if (= ra rb)
        false
        (let [ka (get (field s rank) ra)
              kb (get (field s rank) rb)]
          (cond (< ka kb) (set! (mut (field s parent)) ra rb)
                (> ka kb) (set! (mut (field s parent)) rb ra)
                :else (do (set! (mut (field s parent)) rb ra)
                          (set! (mut (field s rank)) ra (+ ka 1))))
          true))))

(defn components [(g (ref Graph))] (-> i64)
  (let [(mut s) (sets (size g))
        (mut count) (size g)]
    (for i (range 0 (size g))
      (for (ref e) (Vec::at (field g edges) i)
        (when (union! (mut s) i (.to e)) (set! count (- count 1)))))
    count))

;; ---- driver --------------------------------------------------------------------

(defn show [(xs (ref (Vec i64)))] (-> void)
  (for (ref x) xs (print "{} " x))
  (println ""))

(defn main [] (-> i64)
  (let [(mut g) (graph 6)]
    (add-edge! (mut g) 0 1 7)
    (add-edge! (mut g) 0 2 9)
    (add-edge! (mut g) 0 5 14)
    (add-edge! (mut g) 1 2 10)
    (add-edge! (mut g) 1 3 15)
    (add-edge! (mut g) 2 3 11)
    (add-edge! (mut g) 2 5 2)
    (add-edge! (mut g) 5 4 9)
    (add-edge! (mut g) 3 4 6)
    (print "distances from 0: ")
    (show (dijkstra g 0))
    (match (topological g)
      (Some [order] (print "an order: ") (show order))
      (None [] (println "a cycle")))
    (add-edge! (mut g) 4 0 1)
    (match (topological g)
      (Some [order] (print "an order: ") (show order))
      (None [] (println "with 4 -> 0 there is a cycle")))
    (println "components: {}" (components g)))
  (let [(mut h) (graph 5)]
    (add-edge! (mut h) 0 1 1)
    (add-edge! (mut h) 3 4 1)
    (println "components of the second: {}" (components h)))
  0)
