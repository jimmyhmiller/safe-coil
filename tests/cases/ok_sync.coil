(module case.ok-sync)
(import "coil.primitive" :as primitive)
(import "safe.thread" :use [spawn Task])
(import "safe.sync" :use [Arc Mutex with-lock Channel])
(import "safe.vec" :use [Vec])
(import "safe.box" :use [Box])
(defn add-many [(total (Arc (Mutex i64))) (times i64)] (-> i64)
  (for i (range 0 times)
    (with-lock (Arc::get total) n
      (set! n (+ n 1))))
  0)
(defn produce [(out (Channel (Box i64))) (from i64) (count i64)] (-> i64)
  (for i (range 0 count)
    (Channel::send! out (Box::new (+ from i))))
  0)
(defn consume [(in (Channel (Box i64)))] (-> i64)
  (let [(mut sum) 0]
    (loop
      (match (Channel::recv in)
        (Some [b] (set! sum (+ sum (Box::into b))))
        (None [] (break))))
    sum))
(defn main [] (-> i64)
  (let [total (Arc::new (Mutex::new 0))
        a (spawn (add-many (Arc::clone total) 20000))
        b (spawn (add-many (Arc::clone total) 20000))
        channel (Channel::new [(Box i64)])
        reader (spawn (consume (Channel::clone channel)))
        first (spawn (produce (Channel::clone channel) 0 1000))
        second (spawn (produce (Channel::clone channel) 1000 1000))]
    (Task::join a)
    (Task::join b)
    (Task::join first)
    (Task::join second)
    (Channel::close! channel)
    (with-lock (Arc::get total) n
      (println "{} {}" n (Task::join reader)))
    0))
