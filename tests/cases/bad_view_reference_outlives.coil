(module case.bad-view-reference-outlives)
(import "coil.primitive" :as primitive)
(import "safe.core" :use [unsafe lend-mut View])
(defstruct Pt [(x i64) (y i64)])
(defstruct Window [(at (ptr Pt))])
(impl View Window)
(impl Drop Window (drop [(self (mut Window))] (-> void) 0))
(defn window [(p (mut Pt))] (-> Window)
  (unsafe (Window :at (primitive/cast (ptr Pt) (mut p)))))
(defn x-of [(w (mut Window))] (-> (mut i64))
  (unsafe (lend-mut (field (.at w) x))))
(defn first [(p (mut Pt))] (-> (mut i64))
  (let [(mut w) (window (mut p))]
    (x-of (mut w))))
(defn main [] (-> i64) 0)
