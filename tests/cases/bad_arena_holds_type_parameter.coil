(module case.bad-arena-holds-type-parameter)
(import "safe.vec" :use [Vec VecIn])
(import "safe.box" :use [Box BoxIn])
(import "safe.str" :use [Str])
(import "safe.alloc" :use [Arena ArenaRef])
(defstruct Pt [(x i64) (y i64)])
(defstruct Named [(name Str) (n i64)])
(defn put [T] [(a (ref Arena)) (x T)] (-> (BoxIn T ArenaRef)) (BoxIn::in-arena [T] a x))
(defn main [] (-> i64) 0)
