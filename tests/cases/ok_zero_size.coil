(module case.ok-zero-size)
(import "coil.primitive" :as primitive)
(import "safe.core" :use [each])
(import "safe.box" :use [Box])
(import "safe.vec" :use [Vec])
(import "safe.thread" :use [spawn spawn-do Task])
(import "safe.sync" :use [Arc Channel])
(defstruct Unit [])
(defn tick [(u Unit) (out (Channel Unit))] (-> Unit)
  (Channel::send! out (Unit))
  u)
(defn quiet [] (-> void) 0)
(defn main [] (-> i64)
  (let [boxed (Box::new (Unit))
        (mut units) (Vec::new [Unit])
        channel (Channel::new [Unit])
        shared (Arc::new (Unit))
        (mut seen) 0]
    (for i (range 0 100) (Vec::push! (mut units) (Unit)))
    (each [u units] (set! seen (+ seen 1)))
    (let [task (spawn (tick (Box::into boxed) (Channel::clone channel)))
          back (Task::join task)
          done (Task::join (spawn-do (quiet)))]
      (match (Channel::recv channel)
        (Some [u] (set! seen (+ seen 1)))
        (None [] 0)))
    (match (Vec::pop! (mut units))
      (Some [u] (set! seen (+ seen 1)))
      (None [] 0))
    (println "{} {}" seen (Vec::len units))
    0))
