(module case.ok-arena-lists)
(import "safe.vec" :use [Vec VecIn])
(import "safe.box" :use [Box])
(import "safe.alloc" :use [Arena ArenaRef Heap Lease Alloc])
(import "safe.par" :use [par])
(import "safe.core" :use [borrow unsafe])
(defn fill! [(xs (mut (VecIn i64 ArenaRef))) (n i64)] (-> void) (for i (range 0 n) (VecIn::push! (mut xs) i)))
(defn total [(xs (ref (VecIn i64 ArenaRef)))] (-> i64) (let [(mut t) 0] (for i (range 0 (len xs)) (set! t (+ t (get xs i)))) t))
(defn put [(a (ref Arena))] (-> i64) (let [(mut xs) (VecIn::in-arena [i64] a)] (fill! (mut xs) 3) (total xs)))
(defn made [(a (ref Arena))] (-> (VecIn i64 ArenaRef)) (let [(mut xs) (VecIn::in-arena [i64] a)] (fill! (mut xs) 2) xs))
(defn noop [] (-> i64) 0)
(defstruct Holds [(arena Arena) (n i64)])
(defn put-in [(h (ref Holds))] (-> i64) (put (field h arena)))
(defn main [] (-> i64)
  (let [(mut a) (Arena::new)]
    (let [(mut xs) (VecIn::in-arena [i64] a)
          (mut ys) (VecIn::in-arena [i64] a)]
      (fill! (mut xs) 10) (fill! (mut ys) 5)
      (println "{} {}" (total xs) (total ys)))
    (Arena::reset! (mut a))
    (let [zs (made a)] (println "{}" (total zs)))
    0))
