;;; A closure cannot leave the scope of what it borrows.
(module bad_closure_outlives)
(import "safe.fn" :use [deffn lambda])
(deffn Get [] i64)
(defn make [] (-> Get-view)
  (let [n 4
        (mut f) (lambda Get [(ref n)] [] n)]
    (Get-view-of (mut f))))
(defn main [] (-> i64)
  (let [(mut f) (make)] (Get::run (mut f))))
