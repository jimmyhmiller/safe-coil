(module case.bad-global-escape)
(import "safe.global" :use [defglobal with-ref with-mut Global])
(defstruct Pt [(x i64) (y i64)])
(defglobal origin Pt (Pt :x 1 :y 2))
(defn idr [(a (ref Pt))] (-> (ref Pt)) a)
(defn main [] (-> i64)
  (let [r (with-ref (origin) o (idr o))]
    (with-mut (origin) o (set! (.x o) 5))
    (.x r)))
