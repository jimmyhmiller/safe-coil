(module case.bad-extern-call)
(import "safe.core" :use [unsafe])
(defstruct Pt [(x i64) (y i64)])
(defstruct Line [(a Pt) (b Pt)])
(defstruct Res [(id i64)])
(impl Drop Res (drop [(self (mut Res))] (-> void) 0))
(defn bump [(p (mut Pt))] (-> void) (set! (.x p) (+ (.x p) 1)))
(defn pick [(a (ref Pt)) (b (ref Pt))] (-> (ref Pt)) (if (> (.x a) (.x b)) a b))
(defn idr [(a (ref Pt))] (-> (ref Pt)) a)
(defn idm [(a (mut Pt))] (-> (mut Pt)) a)
(defn both [(a (mut Pt)) (b (ref Pt))] (-> i64) (set! (.x a) 9) (.x b))
(defn eat [(r Res)] (-> i64) (.id r))
(defn peek [(r (ref Res))] (-> (ref i64)) (field r id))
(import "coil.cc" :as cc)
(extern strlen :cc (cc/C) [(ptr i8)] (-> u64))
(defn main [] (-> i64) (primitive/cast i64 (strlen c"abc")))
(import "coil.primitive" :as primitive)
