(module case.ok-lock-temporary-guard)
(import "coil.primitive" :as primitive)
(import "safe.sync" :use [Mutex Guard])
(defn main [] (-> i64)
  (let [m (Mutex::new 1)]
    (println "{}" (primitive/load (Guard::get (Mutex::lock m))))
    (println "{}" (primitive/load (Guard::get (Mutex::lock m))))
    0))
