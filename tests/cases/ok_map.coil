(module case.ok-map)
(import "coil.primitive" :as primitive)
(import "safe.map" :use [Map])
(import "safe.str" :use [Str])
(import "safe.box" :use [Box])
(defn total [(m (ref (Map i64 (Box i64))))] (-> i64)
  (let [(mut sum) 0
        (mut c) (Map::first m)]
    (while (>= c 0)
      (set! sum (+ sum (primitive/load (Box::get (Map::value-at m c)))))
      (set! c (Map::next m c)))
    sum))
(defn main [] (-> i64)
  (let [(mut ages) (Map::new [Str i64])
        (mut boxes) (Map::new [i64 (Box i64)])
        ada (Str::from "ada")]
    (Map::insert! (mut ages) (Str::from "ada") 36)
    (Map::insert! (mut ages) (Str::from "alan") 41)
    (match (Map::insert! (mut ages) (Str::from "alan") 42)
      (Some [before] (println "alan was {}" before))
      (None [] (println "alan is new")))
    (set! (mut (Map::at-mut (mut ages) ada)) 37)
    (println "{} {} {}" (Map::len ages) (primitive/load (Map::at ages ada)) (Map::has? ages (Str::from "grace")))
    (for i (range 0 100) (Map::insert! (mut boxes) i (Box::new (* i 2))))
    (for i (range 0 50) (Map::remove! (mut boxes) (* i 2)))
    (println "{} {}" (Map::len boxes) (total boxes))
    (match (Map::remove! (mut ages) ada)
      (Some [age] age)
      (None [] 0))))
