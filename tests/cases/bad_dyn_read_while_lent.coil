;;; What a trait object was made from is lent exclusively while it is used.
(module bad_dyn_read_while_lent)
(deftrait Counter [Self] (bump [(self (ptr Self))] (-> i64)))
(defstruct Clicks [(n i64)])
(impl Counter Clicks (bump [(self (ptr Clicks))] (-> i64) (.n self)))
(defn read-and-bump [(n (ref Clicks)) (c (dyn Counter))] (-> i64) (+ (.n n) (bump c)))
(defn main [] (-> i64)
  (let [(mut c) (Clicks :n 0)] (read-and-bump c (mut c))))
