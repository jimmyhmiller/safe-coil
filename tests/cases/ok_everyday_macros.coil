(module case.ok-everyday-macros)
(import "safe.box" :use [Box])
(defstruct Pt [(x i64) (y i64)])
(defsum Shape (Circle [(r i64)]) (Rect [(w i64) (h i64)]))
(defn area [(s (ref Shape))] (-> i64) (match s (Circle [r] (* r r)) (Rect [w h] (* w h))))
(defn half [(n i64)] (-> (Option i64)) (if (= (% n 2) 0) (Some (/ n 2)) (None [i64])))
(defn safe-div [(a i64) (b i64)] (-> (Result i64 i64)) (if (= b 0) (Err [i64 i64] 1) (Ok [i64 i64] (/ a b))))
(defn chain [(a i64)] (-> (Result i64 i64)) (try (let [x (try! (safe-div a 2))] (Ok [i64 i64] (+ x 1)))))
(defn main [] (-> i64)
  (let [(mut n) 0
        s (Rect :w 2 :h 3)]
    (when (> (area s) 100) (panic "too big {}" (area s)))
    (if-let [(Some [h]) (half 10)] (set! n (+ n h)) (set! n 0))
    (when-let [(Some [h]) (half 3)] (set! n (+ n h)))
    (set! n (+ n (case n 5 1 6 2 0)))
    (assert (> n 0))
    (while (< n 10) (set! n (+ n 1)))
    (for i (range 0 3) (when (= i 1) (continue)) (set! n (+ n i)))
    (cond (> n 100) (unreachable) :else 0)
    (match (chain 8) (Ok [v] (set! n (+ n v))) (Err [e] (set! n e)))
    (block :out (when (> n 3) (return-from :out n)) 0)))
