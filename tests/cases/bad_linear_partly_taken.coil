(module case.bad-linear-partly-taken)
(import "safe.core" :use [Linear Droppable destroy])
(defstruct Tx [(conn i64) (amount i64)])
(impl Drop Tx (drop [(self (mut Tx))] (-> void) 0))
(impl Linear Tx)
(defn open [(id i64)] (-> Tx) (Tx :conn id :amount 0))
(defn commit [(t Tx)] (-> i64) (let [n (.amount t)] (destroy t) n))
(defstruct Deal [(a Tx) (b Tx)])
(impl Linear Deal)
(defn half [(d Deal)] (-> i64) (let [a (.a d)] (commit a)))
(defn main [] (-> i64) (half (Deal :a (open 1) :b (open 2))))
