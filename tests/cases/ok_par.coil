(module case.ok-par)
(import "coil.primitive" :as primitive)
(import "safe.par" :use [par])
(import "safe.core" :use [borrow])
(import "safe.box" :use [Box])
(defstruct Pt [(x i64) (y i64)])
(defn fill [(p (mut Pt)) (from (ref i64)) (extra (Box i64)) (k i64)] (-> i64)
  (set! (.x p) (+ (primitive/load from) (+ (Box::into extra) k)))
  0)
(defn count-up [(n (mut i64)) (to i64)] (-> void)
  (while (< n to) (set! n (+ n 1))))
(defn main [] (-> i64)
  (let [(mut p) (Pt :x 0 :y 0)
        (mut n) 0
        base 30]
    (par (fill (mut p) (borrow base) (Box::new 10) 2)
         (count-up (mut n) 1000))
    (println "{} {}" (.x p) n)
    (.x p)))
