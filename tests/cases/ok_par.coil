(module case.ok-par)
(import "coil.primitive" :as primitive)
(import "safe.par" :use [par])
(import "safe.core" :use [borrow])
(import "safe.box" :use [Box])
(defstruct Pt [(x i64) (y i64)])
(defn fill [(p (mut Pt)) (from (ref i64)) (extra (Box i64)) (k i64)] (-> i64)
  (set! (.x p) (+ (primitive/load from) (+ (Box::into extra) k)))
  0)
(defn count-up [(n (mut i64)) (to i64)] (-> void)
  (while (< n to) (set! n (+ n 1))))
(defn ten [(a (mut i64)) (b i64) (c i64) (d i64) (e i64) (f i64) (g i64) (h i64) (i (ref i64)) (j (Box i64))] (-> i64)
  (set! a (+ b c d e f g h (primitive/load i) (Box::into j)))
  0)
(defn main [] (-> i64)
  (let [(mut p) (Pt :x 0 :y 0)
        (mut n) 0
        base 30]
    (par (fill (mut p) (borrow base) (Box::new 10) 2)
         (count-up (mut n) 1000))
    (println "{} {}" (.x p) n)
    (let [(mut sum) 0]
      (par (ten (mut sum) 1 2 3 4 5 6 7 (borrow base) (Box::new 9))
           (count-up (mut n) 2000))
      (println "{} {}" sum n))
    (.x p)))
