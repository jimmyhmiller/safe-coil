(module case.ok-view-literal)
(import "coil.primitive" :as primitive)
(import "safe.core" :use [View])
(import "safe.vec" :use [Vec Slice])
(import "safe.box" :use [BoxIn])
(import "safe.alloc" :use [Arena ArenaRef])
(defstruct Two [(a (BoxIn i64 ArenaRef)) (s (Slice i64))])
(impl View Two)
(impl Drop Two (drop [(self (mut Two))] (-> void) 0))
(defn first [(t (ref Two))] (-> i64) (+ (primitive/load (BoxIn::get (.a t))) (primitive/load (Slice::at (field t s) 0))))
(defn main [] (-> i64)
  (let [(mut ar) (Arena::new)
        (mut v) (Vec::new [i64])]
    (Vec::push! (mut v) 2)
    (let [t (Two :a (BoxIn::in-arena [i64] ar 1) :s (Vec::slice v 0 1))]
      (println "{}" (first t)))
    (Arena::reset! (mut ar))
    (Vec::push! (mut v) 3)
    0))
