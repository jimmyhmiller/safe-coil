(module case.ok-spawn)
(import "coil.primitive" :as primitive)
(import "safe.thread" :use [spawn spawn-do Task])
(import "safe.sync" :use [Arc Mutex with-lock])
(import "safe.box" :use [Box])
(import "safe.vec" :use [Vec])
(defn sum-to [(n i64) (extra (Box i64))] (-> i64)
  (let [(mut total) (Box::into extra)]
    (for i (range 0 n) (set! total (+ total i)))
    total))
(defn squares [(n i64)] (-> (Vec i64))
  (let [(mut v) (Vec::new [i64])]
    (for i (range 0 n) (Vec::push! (mut v) (* i i)))
    v))
(defn idle [] (-> i64) 0)
(defn nine [(a i64) (b i64) (c i64) (d i64) (e i64) (f i64) (g i64) (h i64) (i (Box i64))] (-> i64)
  (+ a b c d e f g h (Box::into i)))
(defn add! [(total (Arc (Mutex i64))) (n i64)] (-> void)
  (with-lock (Arc::get total) sum
    (set! sum (+ sum n)))
  0)
(defn hello [] (-> void)
  (println "hello")
  0)
(defn main [] (-> i64)
  (let [a (spawn (sum-to 1000 (Box::new 7)))
        b (spawn (squares 10))
        c (spawn (idle))
        d (spawn (sum-to 10 (Box::new 0)))]
    (Task::detach c)
    (println "{}" (Task::join (spawn (nine 1 2 3 4 5 6 7 8 (Box::new 9)))))
    (let [total (Arc::new (Mutex::new 0))
          one (spawn-do (add! (Arc::clone total) 5))
          two (spawn-do (add! (Arc::clone total) 6))
          said (spawn-do (hello))]
      (Task::join one)
      (Task::join two)
      (Task::join said)
      (with-lock (Arc::get total) sum
        (println "{}" sum)))
    (let [v (Task::join b)]
      (println "{} {}" (Task::join a) (primitive/load (Vec::at v 9))))
    0))
