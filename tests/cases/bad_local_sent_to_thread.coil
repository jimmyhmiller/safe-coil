(module case.bad-local-sent-to-thread)
(import "coil.primitive" :as primitive)
(import "safe.local" :use [deflocal with-local Local])
(import "safe.thread" :use [spawn Task])
(deflocal counter i64 0)
(defn bump [(theirs (Local i64))] (-> i64)
  (with-local theirs c (set! c (+ c 1)))
  0)
(defn main [] (-> i64)
  (Task::join (spawn (bump (counter)))))
