(module case.ok-arena-plain-contents)
(import "safe.vec" :use [Vec VecIn])
(import "safe.box" :use [Box BoxIn])
(import "safe.str" :use [Str])
(import "safe.alloc" :use [Arena ArenaRef])
(defstruct Pt [(x i64) (y i64)])
(defstruct Named [(name Str) (n i64)])
(defn main [] (-> i64)
  (let [a (Arena::new)
        (mut xs) (VecIn::in-arena [Pt] a)
        b (BoxIn::in-arena [Pt] a (Pt :x 1 :y 2))]
    (VecIn::push! (mut xs) (Pt :x 3 :y 4))
    (+ (.x (VecIn::at xs 0)) (.y (BoxIn::get b)))))
